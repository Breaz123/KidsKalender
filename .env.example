# Database
POSTGRES_USER=kidscalendar
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=kidscalendar
DATABASE_URL=postgresql://kidscalendar:change_me_strong_password@localhost:5433/kidscalendar

# API
NODE_ENV=development
API_PORT=3001
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars
SESSION_DURATION_HOURS=2160
COOKIE_SECURE=false
# lax (default, same-site / Caddy) | strict | none (Vercel↔API; requires Secure)
COOKIE_SAMESITE=lax
# Exact frontend origin(s), no trailing slash. Comma-separated for multiple.
# Local Vite: http://localhost:5173
# Docker+Caddy: https://your-domain (or leave unset so compose uses https://$DOMAIN)
# Vercel + Docker: https://kids-kalender.vercel.app,https://kalender.breaz-it.be
# (see docs/SPLIT_HOSTING.md)
CORS_ORIGIN=http://localhost:5173

# Web: leeg laten in development (Vite proxy). Productiebuild via Docker zet dit leeg.
# Mode A (vercel.json rewrite): leave empty on Vercel.
# Mode B (cross-origin): https://kalender.breaz-it.be (geen trailing slash)
VITE_API_URL=

# Production domain (for Caddy HTTPS)
DOMAIN=kalender.example.com
ACME_EMAIL=admin@example.com

# Backup
BACKUP_RETENTION_DAYS=14

# Ouderaccounts (npm run users:test)
PASSWORD_PAPA=change_me_papa_password
PASSWORD_MAMA=change_me_mama_password
